# Settings of the hosted server. Copy to .env and fill in; docs/hosted.md
# explains each one. The standalone mode (libre-mcp) needs none of this.

# Secret: this app's key in MyAuth (APP_KEYS: "mcp-libre": "<same value>").
# The LibreLinkUp session comes from MyAuth with it; the server refuses to
# start without it.   openssl rand -hex 32
MYAUTH_APP_KEY=

# MyAuth, as the container reaches it, and the port of its public pages.
MYAUTH_URL=http://myauth:8000
MYAUTH_PUBLIC_PORT=1000
MYAUTH_APP=mcp-libre

# Public face for the AI clients, and the browser face (account and consent
# pages). Unset, everything uses the host of the request.
PUBLIC_URL=https://mcp.example.com/libre
MCP_URL=https://mcp.example.com/libre
UI_URL=https://home.example.com:1031

# Optional: shown in the page footer after the version.
FOOTER_NOTE=
# Fallback for users without a time zone in MyAuth (collector).
TZ=Europe/Berlin
